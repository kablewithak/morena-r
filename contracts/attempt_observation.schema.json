{
  "$defs": {
    "AttemptTransportStatus": {
      "enum": [
        "completed",
        "timeout",
        "execution_error"
      ],
      "title": "AttemptTransportStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "completed_at_utc": {
      "format": "date-time",
      "title": "Completed At Utc",
      "type": "string"
    },
    "elapsed_seconds": {
      "minimum": 0,
      "title": "Elapsed Seconds",
      "type": "number"
    },
    "input_token_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Token Count"
    },
    "model_inference_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Inference Seconds"
    },
    "output_token_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Token Count"
    },
    "prompt_sha256": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Sha256"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at_utc": {
      "format": "date-time",
      "title": "Started At Utc",
      "type": "string"
    },
    "stop_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "transport_status": {
      "$ref": "#/$defs/AttemptTransportStatus"
    },
    "worker_returncode": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Returncode"
    }
  },
  "required": [
    "case_id",
    "transport_status",
    "started_at_utc",
    "completed_at_utc",
    "elapsed_seconds"
  ],
  "title": "AttemptObservation",
  "type": "object"
}
