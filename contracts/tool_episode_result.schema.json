{
  "$defs": {
    "Answerability": {
      "enum": [
        "SUPPORTED",
        "UNSUPPORTED",
        "CONFLICTING",
        "INSUFFICIENT_CONTEXT",
        "NOT_APPLICABLE"
      ],
      "title": "Answerability",
      "type": "string"
    },
    "AskClarificationResponse": {
      "additionalProperties": false,
      "properties": {
        "answerability": {
          "$ref": "#/$defs/Answerability"
        },
        "decision": {
          "const": "ASK_CLARIFICATION",
          "title": "Decision",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "OK",
          "default": "OK",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "answerability",
        "question"
      ],
      "title": "AskClarificationResponse",
      "type": "object"
    },
    "AttemptErrorCode": {
      "enum": [
        "PARSE_ERROR",
        "UNKNOWN_FIELD",
        "INVALID_TOOL",
        "ARGUMENT_INVALID",
        "CONTEXT_OVERFLOW",
        "BUDGET_EXHAUSTED",
        "TIMEOUT",
        "EXECUTION_ERROR"
      ],
      "title": "AttemptErrorCode",
      "type": "string"
    },
    "CalculateArgs": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "title": "Left",
          "type": "number"
        },
        "operation": {
          "$ref": "#/$defs/CalculationOperation"
        },
        "right": {
          "title": "Right",
          "type": "number"
        }
      },
      "required": [
        "operation",
        "left",
        "right"
      ],
      "title": "CalculateArgs",
      "type": "object"
    },
    "CalculateCall": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "$ref": "#/$defs/CalculateArgs"
        },
        "tool": {
          "const": "calculate",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "title": "CalculateCall",
      "type": "object"
    },
    "CalculateData": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "calculate",
          "default": "calculate",
          "title": "Kind",
          "type": "string"
        },
        "result": {
          "title": "Result",
          "type": "number"
        }
      },
      "required": [
        "result"
      ],
      "title": "CalculateData",
      "type": "object"
    },
    "CalculationOperation": {
      "enum": [
        "add",
        "subtract",
        "multiply",
        "divide"
      ],
      "title": "CalculationOperation",
      "type": "string"
    },
    "CallToolResponse": {
      "additionalProperties": false,
      "properties": {
        "answerability": {
          "$ref": "#/$defs/Answerability"
        },
        "decision": {
          "const": "CALL_TOOL",
          "title": "Decision",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "OK",
          "default": "OK",
          "title": "Status",
          "type": "string"
        },
        "tool_call": {
          "discriminator": {
            "mapping": {
              "calculate": "#/$defs/CalculateCall",
              "get_record": "#/$defs/GetRecordCall",
              "lookup_status": "#/$defs/LookupStatusCall",
              "search_records": "#/$defs/SearchRecordsCall"
            },
            "propertyName": "tool"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SearchRecordsCall"
            },
            {
              "$ref": "#/$defs/GetRecordCall"
            },
            {
              "$ref": "#/$defs/CalculateCall"
            },
            {
              "$ref": "#/$defs/LookupStatusCall"
            }
          ],
          "title": "Tool Call"
        }
      },
      "required": [
        "decision",
        "answerability",
        "tool_call"
      ],
      "title": "CallToolResponse",
      "type": "object"
    },
    "EpisodeEvent": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "actor": {
          "enum": [
            "model",
            "tool",
            "runtime"
          ],
          "title": "Actor",
          "type": "string"
        },
        "artifact_ref": {
          "minLength": 1,
          "title": "Artifact Ref",
          "type": "string"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "elapsed_seconds": {
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "event_time_utc": {
          "format": "date-time",
          "title": "Event Time Utc",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "case_id",
        "actor",
        "action",
        "status",
        "event_time_utc",
        "elapsed_seconds",
        "artifact_ref"
      ],
      "title": "EpisodeEvent",
      "type": "object"
    },
    "EpisodeTerminalStatus": {
      "enum": [
        "completed",
        "invalid_response",
        "budget_exhausted",
        "stagnation"
      ],
      "title": "EpisodeTerminalStatus",
      "type": "string"
    },
    "EpisodeTurn": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "generation",
            "format_repair"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parse_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParseFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_output": {
          "title": "Raw Output",
          "type": "string"
        },
        "response": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "ASK_CLARIFICATION": "#/$defs/AskClarificationResponse",
                  "CALL_TOOL": "#/$defs/CallToolResponse",
                  "REFUSE": "#/$defs/RefuseResponse",
                  "RESPOND": "#/$defs/RespondResponse"
                },
                "propertyName": "decision"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/RespondResponse"
                },
                {
                  "$ref": "#/$defs/CallToolResponse"
                },
                {
                  "$ref": "#/$defs/AskClarificationResponse"
                },
                {
                  "$ref": "#/$defs/RefuseResponse"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response"
        },
        "turn_index": {
          "minimum": 1,
          "title": "Turn Index",
          "type": "integer"
        }
      },
      "required": [
        "turn_index",
        "kind",
        "raw_output"
      ],
      "title": "EpisodeTurn",
      "type": "object"
    },
    "EvidenceClaim": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "claim"
      ],
      "title": "EvidenceClaim",
      "type": "object"
    },
    "GetRecordArgs": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id"
      ],
      "title": "GetRecordArgs",
      "type": "object"
    },
    "GetRecordCall": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "$ref": "#/$defs/GetRecordArgs"
        },
        "tool": {
          "const": "get_record",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "title": "GetRecordCall",
      "type": "object"
    },
    "GetRecordData": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "get_record",
          "default": "get_record",
          "title": "Kind",
          "type": "string"
        },
        "record": {
          "$ref": "#/$defs/RecordFixture"
        }
      },
      "required": [
        "record"
      ],
      "title": "GetRecordData",
      "type": "object"
    },
    "LookupStatusArgs": {
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id"
      ],
      "title": "LookupStatusArgs",
      "type": "object"
    },
    "LookupStatusCall": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "$ref": "#/$defs/LookupStatusArgs"
        },
        "tool": {
          "const": "lookup_status",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "title": "LookupStatusCall",
      "type": "object"
    },
    "LookupStatusData": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "lookup_status",
          "default": "lookup_status",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/StatusFixture"
        }
      },
      "required": [
        "status"
      ],
      "title": "LookupStatusData",
      "type": "object"
    },
    "ParseFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/AttemptErrorCode"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ParseFailure",
      "type": "object"
    },
    "RecordFixture": {
      "additionalProperties": false,
      "properties": {
        "authoritative": {
          "default": true,
          "title": "Authoritative",
          "type": "boolean"
        },
        "observed_at": {
          "format": "date",
          "title": "Observed At",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "text",
        "observed_at"
      ],
      "title": "RecordFixture",
      "type": "object"
    },
    "RefuseResponse": {
      "additionalProperties": false,
      "properties": {
        "answerability": {
          "$ref": "#/$defs/Answerability"
        },
        "decision": {
          "const": "REFUSE",
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "OK",
          "default": "OK",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "answerability",
        "reason"
      ],
      "title": "RefuseResponse",
      "type": "object"
    },
    "RespondResponse": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "answerability": {
          "$ref": "#/$defs/Answerability"
        },
        "citations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "claims": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceClaim"
          },
          "title": "Claims",
          "type": "array"
        },
        "decision": {
          "const": "RESPOND",
          "title": "Decision",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "OK",
          "default": "OK",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "answerability",
        "answer"
      ],
      "title": "RespondResponse",
      "type": "object"
    },
    "SearchRecordsArgs": {
      "additionalProperties": false,
      "properties": {
        "as_of_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of Date"
        },
        "limit": {
          "default": 5,
          "maximum": 10,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "query": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "SearchRecordsArgs",
      "type": "object"
    },
    "SearchRecordsCall": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "$ref": "#/$defs/SearchRecordsArgs"
        },
        "tool": {
          "const": "search_records",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "title": "SearchRecordsCall",
      "type": "object"
    },
    "SearchRecordsData": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "search_records",
          "default": "search_records",
          "title": "Kind",
          "type": "string"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/RecordFixture"
          },
          "title": "Records",
          "type": "array"
        }
      },
      "required": [
        "records"
      ],
      "title": "SearchRecordsData",
      "type": "object"
    },
    "StatusFixture": {
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "format": "date",
          "title": "Observed At",
          "type": "string"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "subject_id": {
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "status",
        "observed_at"
      ],
      "title": "StatusFixture",
      "type": "object"
    },
    "ToolErrorCode": {
      "enum": [
        "PARSE_ERROR",
        "UNKNOWN_FIELD",
        "INVALID_TOOL",
        "ARGUMENT_INVALID",
        "CONTEXT_OVERFLOW",
        "BUDGET_EXHAUSTED",
        "PERMISSION_DENIED",
        "NOT_FOUND",
        "TIMEOUT",
        "MALFORMED_RESPONSE",
        "STALE_DATA",
        "STAGNATION"
      ],
      "title": "ToolErrorCode",
      "type": "string"
    },
    "ToolName": {
      "enum": [
        "search_records",
        "get_record",
        "calculate",
        "lookup_status"
      ],
      "title": "ToolName",
      "type": "string"
    },
    "ToolResult": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "calculate": "#/$defs/CalculateData",
                  "get_record": "#/$defs/GetRecordData",
                  "lookup_status": "#/$defs/LookupStatusData",
                  "search_records": "#/$defs/SearchRecordsData"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/SearchRecordsData"
                },
                {
                  "$ref": "#/$defs/GetRecordData"
                },
                {
                  "$ref": "#/$defs/CalculateData"
                },
                {
                  "$ref": "#/$defs/LookupStatusData"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "payload_hash": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Hash"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        },
        "tool": {
          "$ref": "#/$defs/ToolName"
        }
      },
      "required": [
        "call_id",
        "tool",
        "success"
      ],
      "title": "ToolResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/EpisodeEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "final_response": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "ASK_CLARIFICATION": "#/$defs/AskClarificationResponse",
              "CALL_TOOL": "#/$defs/CallToolResponse",
              "REFUSE": "#/$defs/RefuseResponse",
              "RESPOND": "#/$defs/RespondResponse"
            },
            "propertyName": "decision"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RespondResponse"
            },
            {
              "$ref": "#/$defs/CallToolResponse"
            },
            {
              "$ref": "#/$defs/AskClarificationResponse"
            },
            {
              "$ref": "#/$defs/RefuseResponse"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Response"
    },
    "parse_failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParseFailure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime_error_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolErrorCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/EpisodeTerminalStatus"
    },
    "tool_results": {
      "items": {
        "$ref": "#/$defs/ToolResult"
      },
      "title": "Tool Results",
      "type": "array"
    },
    "turns": {
      "items": {
        "$ref": "#/$defs/EpisodeTurn"
      },
      "title": "Turns",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "status",
    "turns",
    "tool_results",
    "events"
  ],
  "title": "ToolEpisodeResult",
  "type": "object"
}
